import numpy as np
import pandas as pd

import kagglehub
from kagglehub import KaggleDatasetAdapter

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler, OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline

from sklearn.linear_model import LogisticRegression
from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier

from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix
)


file_path = "student-mat.csv"

df = kagglehub.load_dataset(
    KaggleDatasetAdapter.PANDAS,
    "dskagglemt/student-performance-data-set",
    file_path,
    pandas_kwargs={"sep": ";"}
)

print("Dataset shape:", df.shape)
print("\nFirst rows:")
print(df.head())

print("\nDataset info:")
print(df.info())

print("\nMissing values:")
print(df.isna().sum())

df["at_risk"] = (df["G3"] < 10).astype(int)

print("\nTarget distribution:")
print(df["at_risk"].value_counts())
print("\nTarget distribution, normalized:")
print(df["at_risk"].value_counts(normalize=True))


print("\nAverage numeric values by risk group:")
eda_grouped = df.groupby("at_risk")[
    ["studytime", "failures", "absences", "G1", "G2", "G3"]
].mean()
print(eda_grouped)

print("\nAt-risk rate by internet access:")
internet_risk = df.groupby("internet")["at_risk"].mean()
print(internet_risk)


y = df["at_risk"]

baseline_preds = np.zeros(len(y))

print("\n=========================")
print("Majority-class baseline on full dataset")
print("=========================")

print("Accuracy:", accuracy_score(y, baseline_preds))
print("\nClassification report:")
print(classification_report(y, baseline_preds, zero_division=0))
print("\nConfusion matrix:")
print(confusion_matrix(y, baseline_preds))


def evaluate_model(model_name, y_true, y_pred):
    """Print common classification metrics for a model."""
    print("\n=========================")
    print(model_name)
    print("=========================")
    print("Accuracy:", accuracy_score(y_true, y_pred))
    print("\nClassification report:")
    print(classification_report(y_true, y_pred, zero_division=0))
    print("\nConfusion matrix:")
    print(confusion_matrix(y_true, y_pred))


X_with_grades = df.drop(["at_risk", "G3"], axis=1)
y = df["at_risk"]

num_cols_with_grades = X_with_grades.select_dtypes(include=np.number).columns
cat_cols_with_grades = X_with_grades.select_dtypes(include="object").columns

X_train_with_grades, X_test_with_grades, y_train, y_test = train_test_split(
    X_with_grades,
    y,
    test_size=0.2,
    random_state=42,
    stratify=y
)

preprocessor_with_grades = ColumnTransformer(
    transformers=[
        ("num", StandardScaler(), num_cols_with_grades),
        ("cat", OneHotEncoder(handle_unknown="ignore"), cat_cols_with_grades),
    ]
)

logreg_with_grades = Pipeline(
    steps=[
        ("preprocessor", preprocessor_with_grades),
        ("classifier", LogisticRegression(max_iter=1000))
    ]
)

logreg_with_grades.fit(X_train_with_grades, y_train)
preds_logreg_with_grades = logreg_with_grades.predict(X_test_with_grades)

evaluate_model(
    "Logistic Regression with previous grades G1/G2",
    y_test,
    preds_logreg_with_grades
)


baseline_test_preds = np.zeros(len(y_test))

evaluate_model(
    "Majority-class baseline on test set",
    y_test,
    baseline_test_preds
)


X_early = df.drop(["at_risk", "G1", "G2", "G3"], axis=1)
y_early = df["at_risk"]

num_cols_early = X_early.select_dtypes(include=np.number).columns
cat_cols_early = X_early.select_dtypes(include="object").columns

X_train_early, X_test_early, y_train_early, y_test_early = train_test_split(
    X_early,
    y_early,
    test_size=0.2,
    random_state=42,
    stratify=y_early
)

print("\nEarly prediction train target distribution:")
print(y_train_early.value_counts(normalize=True))

print("\nEarly prediction test target distribution:")
print(y_test_early.value_counts(normalize=True))

preprocessor_early = ColumnTransformer(
    transformers=[
        ("num", StandardScaler(), num_cols_early),
        ("cat", OneHotEncoder(handle_unknown="ignore"), cat_cols_early),
    ]
)


logreg_early = Pipeline(
    steps=[
        ("preprocessor", preprocessor_early),
        ("classifier", LogisticRegression(max_iter=1000))
    ]
)

logreg_early.fit(X_train_early, y_train_early)
preds_logreg_early = logreg_early.predict(X_test_early)

evaluate_model(
    "Logistic Regression without G1/G2, threshold 0.5",
    y_test_early,
    preds_logreg_early
)


rf_early = Pipeline(
    steps=[
        ("preprocessor", preprocessor_early),
        (
            "classifier",
            RandomForestClassifier(
                n_estimators=200,
                random_state=42,
                class_weight="balanced"
            )
        )
    ]
)

rf_early.fit(X_train_early, y_train_early)
preds_rf_early = rf_early.predict(X_test_early)

evaluate_model(
    "Random Forest without G1/G2",
    y_test_early,
    preds_rf_early
)


gb_early = Pipeline(
    steps=[
        ("preprocessor", preprocessor_early),
        ("classifier", GradientBoostingClassifier(random_state=42))
    ]
)

gb_early.fit(X_train_early, y_train_early)
preds_gb_early = gb_early.predict(X_test_early)

evaluate_model(
    "Gradient Boosting without G1/G2",
    y_test_early,
    preds_gb_early
)


risk_probabilities = logreg_early.predict_proba(X_test_early)[:, 1]

threshold = 0.4
preds_logreg_early_threshold_04 = (risk_probabilities >= threshold).astype(int)

evaluate_model(
    "Logistic Regression without G1/G2, threshold 0.4",
    y_test_early,
    preds_logreg_early_threshold_04
)


summary = pd.DataFrame(
    [
        {
            "model": "Majority baseline",
            "features": "always predicts 0",
            "threshold": "-",
            "accuracy": 0.67,
            "at_risk_recall": 0.00,
            "at_risk_f1": 0.00,
        },
        {
            "model": "Logistic Regression",
            "features": "with G1/G2",
            "threshold": 0.5,
            "accuracy": 0.94,
            "at_risk_recall": 0.85,
            "at_risk_f1": 0.90,
        },
        {
            "model": "Logistic Regression",
            "features": "without G1/G2",
            "threshold": 0.5,
            "accuracy": 0.70,
            "at_risk_recall": 0.31,
            "at_risk_f1": 0.40,
        },
        {
            "model": "Random Forest",
            "features": "without G1/G2",
            "threshold": 0.5,
            "accuracy": 0.68,
            "at_risk_recall": 0.19,
            "at_risk_f1": 0.29,
        },
        {
            "model": "Gradient Boosting",
            "features": "without G1/G2",
            "threshold": 0.5,
            "accuracy": 0.66,
            "at_risk_recall": 0.27,
            "at_risk_f1": 0.34,
        },
        {
            "model": "Logistic Regression",
            "features": "without G1/G2",
            "threshold": 0.4,
            "accuracy": 0.72,
            "at_risk_recall": 0.62,
            "at_risk_f1": 0.59,
        },
    ]
)

print("\n=========================")
print("Project summary")
print("=========================")
print(summary)
